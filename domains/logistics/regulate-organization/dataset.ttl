@prefix ex: <http://example.org/> .
@prefix hmas: <https://purl.org/hmas/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix saref: <https://saref.etsi.org/core/> .
@prefix s4auto: <https://saref.etsi.org/saref4auto/> .
@prefix s4inma: <https://saref.etsi.org/saref4inma/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

## SHACL SPARQL-Constraint prefixes
ex:
    sh:declare [
        sh:prefix "ex" ;
        sh:namespace "http://example.org/" ;
        ] .
hmas:
    sh:declare [
        sh:prefix "hmas" ;
        sh:namespace "https://purl.org/hmas/" ;
        ] .
prov:
    sh:declare [
        sh:prefix "prov" ;
        sh:namespace "http://www.w3.org/ns/prov#" ;
        ] .
rdfs:
    sh:declare [
        sh:prefix "rdfs" ;
        sh:namespace "http://www.w3.org/2000/01/rdf-schema#" ;
        ] .
saref:
    sh:declare [
        sh:prefix "saref" ;
        sh:namespace "https://saref.etsi.org/core/" ;
        ] .
s4auto:
    sh:declare [
        sh:prefix "s4auto" ;
        sh:namespace "https://saref.etsi.org/saref4auto/" ;
        ] .
s4inma:
    sh:declare [
        sh:prefix "s4inma" ;
        sh:namespace "https://saref.etsi.org/saref4inma/" ;
        ] .
        
#################################################################
#    Core Ontology
#################################################################

## Workspace
ex:LogisticsWS a hmas:Workspace ;
    hmas:contains ex:John, ex:Frank, ex:Gabriel, ex:Igor, ex:Jane, ex:Kate, ex:Leo, ex:Marie, ex:Forklift_1, ex:Forklift_2, ex:Forklift_3, ex:Palletjack_1, ex:Palletjack_2, ex:Palletjack_3, ex:Barcode_Reader_1, ex:Barcode_Reader_2, ex:Label_Printer_1, ex:Label_Printer_2, ex:Truck_1 .

## Agents
ex:John a hmas:Agent ;
    hmas:isContainedIn ex:LogisticsWS ;
    hmas:isMemberOf ex:FL_Logistics .
ex:Frank a hmas:Agent ;
    hmas:isContainedIn ex:LogisticsWS ;
    hmas:isMemberOf ex:FL_Logistics .
ex:Gabriel a hmas:Agent ;
    hmas:isContainedIn ex:LogisticsWS ;
    hmas:isMemberOf ex:FL_Logistics .
ex:Igor a hmas:Agent ;
    hmas:isContainedIn ex:LogisticsWS ;
    hmas:isMemberOf ex:FL_Logistics .
ex:Jane a hmas:Agent ;
    hmas:isContainedIn ex:LogisticsWS ;
    hmas:isMemberOf ex:FL_Logistics .
ex:Kate a hmas:Agent ;
    hmas:isContainedIn ex:LogisticsWS ;
    hmas:isMemberOf ex:FL_Logistics .
ex:Leo a hmas:Agent ;
    hmas:isContainedIn ex:LogisticsWS ;
    hmas:isMemberOf ex:FL_Logistics .
ex:Marie a hmas:Agent ;
    hmas:isContainedIn ex:LogisticsWS ;
    hmas:isMemberOf ex:FL_Logistics .
    
## Artifacts
ex:Forklift_1 a hmas:Artifact ;
    hmas:isContainedIn ex:LogisticsWS ;
    hmas:isMaterialOf ex:FL_Logistics ;
    hmas:hasFacility ex:LiftUp, ex:LiftDown, ex:Move .
ex:Forklift_2 a hmas:Artifact ;
    hmas:isContainedIn ex:LogisticsWS ;
    hmas:isMaterialOf ex:FL_Logistics ;
    hmas:hasFacility ex:LiftUp, ex:LiftDown, ex:Move .
ex:Forklift_3 a hmas:Artifact ;
    hmas:isContainedIn ex:LogisticsWS ;
    hmas:isMaterialOf ex:FL_Logistics ;
    hmas:hasFacility ex:LiftUp, ex:LiftDown, ex:Move .
ex:Palletjack_1 a hmas:Artifact ;
    hmas:isContainedIn ex:LogisticsWS ;
    hmas:isMaterialOf ex:FL_Logistics ;
    hmas:hasFacility ex:LiftUp, ex:LiftDown, ex:Move .
ex:Palletjack_2 a hmas:Artifact ;
    hmas:isContainedIn ex:LogisticsWS ;
    hmas:isMaterialOf ex:FL_Logistics ;
    hmas:hasFacility ex:LiftUp, ex:LiftDown, ex:Move .
ex:Palletjack_3 a hmas:Artifact ;
    hmas:isContainedIn ex:LogisticsWS ;
    hmas:isMaterialOf ex:FL_Logistics ;
    hmas:hasFacility ex:LiftUp, ex:LiftDown, ex:Move .
ex:Barcode_Reader_1 a hmas:Artifact ;
    hmas:isContainedIn ex:LogisticsWS ;
    hmas:isMaterialOf ex:FL_Logistics ;
    hmas:hasFacility ex:ReadBarcode .
ex:Barcode_Reader_2 a hmas:Artifact ;
    hmas:isContainedIn ex:LogisticsWS ;
    hmas:isMaterialOf ex:FL_Logistics ;
    hmas:hasFacility ex:ReadBarcode .
ex:Label_Printer_1 a hmas:Artifact ;
    hmas:isContainedIn ex:LogisticsWS ;
    hmas:isMaterialOf ex:FL_Logistics ;
    hmas:hasFacility ex:PrintLabel .
ex:Label_Printer_2 a hmas:Artifact ;
    hmas:isContainedIn ex:LogisticsWS ;
    hmas:isMaterialOf ex:FL_Logistics ;
    hmas:hasFacility ex:PrintLabel .
ex:Truck_1 a hmas:Artifact, s4auto:Truck ;
    hmas:isContainedIn ex:LogisticsWS ;
    hmas:isMaterialOf ex:FL_Logistics ;
    hmas:hasFacility ex:Carry ;
    saref:hasState [
        a s4auto:AtPickUpSpot ;
        ] ;
    ex:isLoadedWith ex:Pallet_1, ex:Pallet_2 .

## Domain application
ex:Pallet_1 a s4inma:Batch .
ex:Pallet_2 a s4inma:Batch .

#################################################################
#    Regulation Ontology
#################################################################

# SPECIFICATION

## NOTE: Regulation entities' specification can be represented
##       using implicit or explicit Target Class SHACL. Here we
##       decided to use implicit Target Class SHACL because we
##       do not expect any extensions for this scenario and we
##       wanted to avoid extra labels.

## Organization Specifications
ex:Logistics a sh:NodeShape, rdfs:Class ;
    rdfs:subClassOf hmas:Organization ;
    sh:property [
        sh:path hmas:hasOrganizationalValue ;
        sh:maxCount 2 ;
        ] ;
    sh:property [
        sh:path hmas:hasOrganizationalValue ;
        sh:hasValue ex:Commitment ;
        ] ;
    sh:property [
        sh:path hmas:hasOrganizationalValue ;
        sh:hasValue ex:IntegrityRespect ;
        ] ;
    sh:property [
        sh:path hmas:hasOrganizationalValue ;
        sh:maxCount 8 ;
        ] ;
    sh:property [
        sh:path hmas:proposesRole ;
        sh:hasValue ex:Director ;
        ] ;
    sh:property [
        sh:path hmas:proposesRole ;
        sh:hasValue ex:HumanResourcesOfficer ;
        ] ;
    sh:property [
        sh:path hmas:proposesRole ;
        sh:hasValue ex:FinanceOfficer ;
        ] ;
    sh:property [
        sh:path hmas:proposesRole ;
        sh:hasValue ex:AccountManager ;
        ] ;
    sh:property [
        sh:path hmas:proposesRole ;
        sh:hasValue ex:Planner ;
        ] ;
    sh:property [
        sh:path hmas:proposesRole ;
        sh:hasValue ex:Carrier ;
        ] ;
    sh:property [
        sh:path hmas:proposesRole ;
        sh:hasValue ex:Collector ;
        ] ;
    sh:property [
        sh:path hmas:proposesRole ;
        sh:hasValue ex:Deliverer ;
        ] ;
    sh:property [
        sh:path hmas:isStructuredBy ;
        sh:minCount 7 ;
        sh:maxCount 7 ;
        ] ;
    sh:property [
        sh:path hmas:isStructuredBy ;
        sh:qualifiedValueShape [ sh:class ex:AdministrativeDepartment ] ;
        sh:qualifiedValuesShapeDisjoint true ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        ] ;
    sh:property [
        sh:path hmas:isStructuredBy ;
        sh:qualifiedValueShape [ sh:class ex:OperationsDepartment ] ;
        sh:qualifiedValuesShapeDisjoint true ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        ] ;
    sh:property [
        sh:path hmas:isStructuredBy ;
        sh:qualifiedValueShape [ sh:class ex:HumanResourcesDepartment ] ;
        sh:qualifiedValuesShapeDisjoint true ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        ] ;
    sh:property [
        sh:path hmas:isStructuredBy ;
        sh:qualifiedValueShape [ sh:class ex:FinanceDepartment ] ;
        sh:qualifiedValuesShapeDisjoint true ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        ] ;
    sh:property [
        sh:path hmas:isStructuredBy ;
        sh:qualifiedValueShape [ sh:class ex:CommercialDepartment ] ;
        sh:qualifiedValuesShapeDisjoint true ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        ] ;
    sh:property [
        sh:path hmas:isStructuredBy ;
        sh:qualifiedValueShape [ sh:class ex:PlanningDepartment ] ;
        sh:qualifiedValuesShapeDisjoint true ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        ] ;
    sh:property [
        sh:path hmas:isStructuredBy ;
        sh:qualifiedValueShape [ sh:class ex:ShippingDepartment ] ;
        sh:qualifiedValuesShapeDisjoint true ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        ] ;
    sh:property [
        sh:path hmas:hasOrganizationalGoal ;
        sh:hasValue ex:HumanResourcesManaged ;
        ] ;
    sh:property [
        sh:path hmas:hasOrganizationalGoal ;
        sh:hasValue ex:FinancialManaged ;
        ] ;
    sh:property [
        sh:path hmas:hasOrganizationalGoal ;
        sh:hasValue ex:CommercialManaged ;
        ] ;
    sh:property [
        sh:path hmas:hasOrganizationalGoal ;
        sh:hasValue ex:PlanningManaged ;
        ] ;
    sh:property [
        sh:path hmas:hasOrganizationalGoal ;
        sh:hasValue ex:ContractSigned ;
        ] ;
    sh:property [
        sh:path hmas:hasOrganizationalGoal ;
        sh:hasValue ex:CandidateSelected ;
        ] ;
    sh:property [
        sh:path hmas:hasOrganizationalGoal ;
        sh:hasValue ex:RecommendationsAssessed ;
        ] ;
    sh:property [
        sh:path hmas:hasOrganizationalGoal ;
        sh:hasValue ex:CandidatesInterviewed ;
        ] ;
    sh:property [
        sh:path hmas:hasOrganizationalGoal ;
        sh:hasValue ex:InterviewsScheduled ;
        ] ;
    sh:property [
        sh:path hmas:hasOrganizationalGoal ;
        sh:hasValue ex:InterviewsConducted ;
        ] ;
    sh:property [
        sh:path hmas:hasOrganizationalGoal ;
        sh:hasValue ex:IntervieweesSelected ;
        ] ;
    sh:property [
        sh:path hmas:hasOrganizationalGoal ;
        sh:hasValue ex:JobPositionAnnounced ;
        ] ;
    sh:property [
        sh:path hmas:hasOrganizationalGoal ;
        sh:hasValue ex:JobPositionWritten ;
        ] ;
    sh:property [
        sh:path hmas:hasOrganizationalGoal ;
        sh:hasValue ex:GoodsStored ;
        ] ;
    sh:property [
        sh:path hmas:hasOrganizationalGoal ;
        sh:hasValue ex:GoodsChecked ;
        ] ;
    sh:property [
        sh:path hmas:hasOrganizationalGoal ;
        sh:hasValue ex:GoodsReceived ;
        ] ;
    sh:property [
        sh:path hmas:hasOrganizationalGoal ;
        sh:hasValue ex:GoodsCarried ;
        ] ;
    sh:property [
        sh:path hmas:hasOrganizationalGoal ;
        sh:hasValue ex:GoodsLoaded ;
        ] ;
    sh:property [
        sh:path hmas:hasOrganizationalGoal ;
        sh:hasValue ex:GoodsLabeled ;
        ] ;
    sh:property [
        sh:path hmas:hasOrganizationalGoal ;
        sh:hasValue ex:GoodsRetrieved ;
        ] ;
    sh:property [
        sh:path hmas:proposesProcess ;
        sh:or (
            [ sh:class ex:Hire_Process ]
            [ sh:class ex:HandleInvoice_Process ]
            [ sh:class ex:ProspectClient_Process ]
            [ sh:class ex:DeliverGoods_Process ]
            [ sh:class ex:TransferGoods_Process ]
            )
        ] ;
    sh:property [
        sh:path hmas:proposesSetting ;
        sh:maxCount 3 ;
        ] ;
    sh:property [
        sh:path hmas:proposesSetting ;
        sh:hasValue ex:ReceiveSetting ;
        ] ;
    sh:property [
        sh:path hmas:proposesSetting ;
        sh:hasValue ex:PickSetting ;
        ] ;
    sh:property [
        sh:path hmas:proposesSetting ;
        sh:hasValue ex:CarrySetting ;
        ] ;
    sh:property [
        sh:path hmas:proposesFacility ;
        sh:maxCount 6 ;
        ] ;
    sh:property [
        sh:path hmas:proposesFacility ;
        sh:hasValue ex:LiftUp ;
        ] ;
    sh:property [
        sh:path hmas:proposesFacility ;
        sh:hasValue ex:LiftDown ;
        ] ;
    sh:property [
        sh:path hmas:proposesFacility ;
        sh:hasValue ex:Move ;
        ] ;
    sh:property [
        sh:path hmas:proposesFacility ;
        sh:hasValue ex:ReadBarcode ;
        ] ;
    sh:property [
        sh:path hmas:proposesFacility ;
        sh:hasValue ex:PrintLabel ;
        ] ;
    sh:property [
        sh:path hmas:proposesFacility ;
        sh:hasValue ex:Carry ;
        ] .

## Group Specifications
ex:AdministrativeDepartment a sh:NodeShape, rdfs:Class ;
    rdfs:subClassOf hmas:Group .
ex:OperationsDepartment a sh:NodeShape, rdfs:Class ;
    rdfs:subClassOf hmas:Group .
ex:HumanResourcesDepartment a sh:NodeShape, rdfs:Class ;
    rdfs:subClassOf hmas:Group ;
    sh:property [
        sh:path hmas:isSubGroupOf ;
        sh:qualifiedValueShape [ sh:class ex:AdministrativeDepartment ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        ] .
ex:FinanceDepartment a sh:NodeShape, rdfs:Class ;
    rdfs:subClassOf hmas:Group ;
    sh:property [
        sh:path hmas:isSubGroupOf ;
        sh:qualifiedValueShape [ sh:class ex:AdministrativeDepartment ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        ] .
ex:CommercialDepartment a sh:NodeShape, rdfs:Class ;
    rdfs:subClassOf hmas:Group ;
    sh:property [
        sh:path hmas:isSubGroupOf ;
        sh:qualifiedValueShape [ sh:class ex:OperationsDepartment ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        ] .
ex:PlanningDepartment a sh:NodeShape, rdfs:Class ;
    rdfs:subClassOf hmas:Group ;
    sh:property [
        sh:path hmas:isSubGroupOf ;
        sh:qualifiedValueShape [ sh:class ex:OperationsDepartment ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        ] .
ex:ShippingDepartment a sh:NodeShape, rdfs:Class ;
    rdfs:subClassOf hmas:Group ;
    sh:property [
        sh:path hmas:isSubGroupOf ;
        sh:qualifiedValueShape [ sh:class ex:OperationsDepartment ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        ] .
        
