### R6
ex:R6 a sh:NodeShape, hmas:Permission ;
    sh:targetClass hmas:Agent ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An Agent in the Collector_Shipping_Membership is permitted to have access in the ReceiveSetting if committed to CollectorGoods_Mission." ;
        sh:prefixes ex:, hmas:, prov:, rdfs:, saref:, s4auto:, s4inma: ;
        sh:select """
            SELECT (?agent as $this)
            WHERE {
                ?membership a ex:Collector_Shipping_Membership .
                ?mission a ex:CollectGoods_Mission.
  
                ?agent ^hmas:isMembershipOf ?membership ;
                       ^hmas:isCommitmentOf/hmas:isCommitmentFor ?mission .
            
                FILTER EXISTS {
                    ?access hmas:isAccessIn ex:ReceiveSetting ;
                            hmas:isAccessOf ?agent .
                }
            }
            """ ;
        ] .
