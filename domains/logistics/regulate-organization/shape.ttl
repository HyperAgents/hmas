## Mission Constraint Specifications
ex:MissionCardinalityShape a sh:NodeShape ;
    sh:targetObjectsOf hmas:isCommitmentFor ;
    sh:property [
        sh:path [ sh:inversePath hmas:isCommitmentFor ] ;
        sh:maxCount 1 ;
        ] .

## Commitment Constraint Specifications
ex:CommitmentCardinalityShape a sh:NodeShape ;
    sh:targetClass hmas:Commitment ;
    sh:property [
        sh:path hmas:isCommitmentOf ;
        sh:maxCount 1 ;
        ] .

## Access Specifications
ex:Receive_Move_Access a sh:NodeShape, rdfs:Class ;
    rdfs:subClassOf hmas:Access ;
    sh:property [
        sh:path hmas:isAccessOf ;
        sh:qualifiedValueShape [ sh:class hmas:Agent ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        ] ;
    sh:property [
        sh:path hmas:isAccessTo ;
        sh:qualifiedValueShape [ sh:class hmas:Artifact ] ;
        sh:qualifiedMinCount 1 ;
        ] ;
    sh:property [
        sh:path hmas:isAccessIn ;
        sh:hasValue ex:ReceiveSetting ;
        ] ;
    sh:property [
        sh:path hmas:isAccessFor ;
        sh:minCount 3 ;
        sh:maxCount 3 ;
        ] ;
    sh:property [
        sh:path hmas:isAccessFor ;
        sh:hasValue ex:LiftUp ;
        ] ;
    sh:property [
        sh:path hmas:isAccessFor ;
        sh:hasValue ex:LiftDown ;
        ] ;
    sh:property [
        sh:path hmas:isAccessFor ;
        sh:hasValue ex:Move ;
        ] .
ex:Receive_ReadBarCode_Access a sh:NodeShape, rdfs:Class ;
    rdfs:subClassOf hmas:Access ;
    sh:property [
        sh:path hmas:isAccessOf ;
        sh:qualifiedValueShape [ sh:class hmas:Agent ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        ] ;
    sh:property [
        sh:path hmas:isAccessTo ;
        sh:qualifiedValueShape [ sh:class hmas:Artifact ] ;
        sh:qualifiedMinCount 1 ;
        ] ;
    sh:property [
        sh:path hmas:isAccessIn ;
        sh:hasValue ex:ReceiveSetting ;
        ] ;
    sh:property [
        sh:path hmas:isAccessFor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ] ;
    sh:property [
        sh:path hmas:isAccessFor ;
        sh:hasValue ex:ReadBarcode ;
        ] .

## Access Constraint Specifications
ex:AccessFacilitiesShape a sh:NodeShape ;
    sh:targetClass hmas:Access ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The artifacts associated to an access should jointly have all the facilities associated to that access." ;
        sh:prefixes ex:, hmas:, rdfs: ;
        sh:select """
          SELECT (?access as $this)
          WHERE {
            ?access hmas:isAccessFor ?facility .

            FILTER NOT EXISTS {
              ?access hmas:isAccessTo ?artifact .
              ?artifact hmas:hasFacility ?facility .
            }
          }
          """ ;
        ] .


## Regulations

### R1
ex:R1 a sh:NodeShape, hmas:Obligation ;
    sh:targetClass hmas:Agent ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An Agent in the Deliverer_Shipping_Membership must commit to the DeliverGoods_Mission if the Agent is not committed to any mission and no other agent is committed to the DeliverGoods_Mission." ;
        sh:prefixes ex:, hmas:, prov:, rdfs:, saref:, s4auto:, s4inma: ;
        sh:select """
            SELECT DISTINCT ?mission
            WHERE {
                ?membership a ex:Deliverer_Shipping_Membership .
                $this ^hmas:isMembershipOf ?membership .

                FILTER NOT EXISTS {
                    $this ^hmas:isCommitmentOf/hmas:isCommitmentFor ?myMission .
                }

                ?mission a ex:DeliverGoods_Mission .
                
                FILTER NOT EXISTS {
                    $this ^hmas:isCommitmentOf/hmas:isCommitmentFor ?mission .
                }
            }
            """ ;
        ] .


### R2
ex:R2 a sh:NodeShape, hmas:Permission ;
    sh:targetClass hmas:Agent ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An Agent in the Deliverer_Shipping_Membership is permitted to have access in the PickSetting if committed to DeliverGoods_Mission." ;
        sh:prefixes ex:, hmas:, prov:, rdfs:, saref:, s4auto:, s4inma: ;
        sh:select """
            SELECT (?agent as $this)
            WHERE {
                ?membership a ex:Deliverer_Shipping_Membership .
                ?mission a ex:DeliverGoods_Mission .

                ?agent ^hmas:isMembershipOf ?membership ;
                       ^hmas:isCommitmentOf/hmas:isCommitmentFor ?mission .

                FILTER EXISTS {
                    ?access hmas:isAccessIn ex:PickSetting ;
                            hmas:isAccessOf ?agent .
                }
            }
            """ ;
        ] .


### R3
ex:R3 a sh:NodeShape, hmas:Obligation ;
    sh:targetClass hmas:Agent ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An Agent in the Carrier_Shipping_Membership must commit to the CarryGoods_Mission if the Agent is not committed to any mission and no other agent is committed to the CarryGoods_Mission." ;
        sh:prefixes ex:, hmas:, prov:, rdfs:, saref:, s4auto:, s4inma: ;
        sh:select """
            SELECT DISTINCT ?mission
            WHERE {
                ?membership a ex:Carrier_Shipping_Membership .
                $this ^hmas:isMembershipOf ?membership .

                FILTER NOT EXISTS {
                    $this ^hmas:isCommitmentOf/hmas:isCommitmentFor ?myMission .
                }

                ?mission a ex:CarryGoods_Mission .
                
                FILTER NOT EXISTS {
                    $this ^hmas:isCommitmentOf/hmas:isCommitmentFor ?mission .
                }
            }
            """ ;
        ] .


### R4
ex:R4 a sh:NodeShape, hmas:Prohibition ;
    sh:targetClass hmas:Agent ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An Agent is forbidden to be associated with an empty truck if committed to a CarryGoods_Mission and not at the pickup location." ;
        sh:prefixes ex:, hmas:, prov:, rdfs:, saref:, s4auto:, s4inma: ;
        sh:select """
            SELECT (?agent as $this)
            WHERE {
                ?membership a ex:Carrier_Shipping_Membership .
                ?mission a ex:CarryGoods_Mission .
                ?agent ^hmas:isMembershipOf ?membership ;
                       ^hmas:isCommitmentOf/hmas:isCommitmentFor ?mission .

                ?activity a ex:Carrying ;
                          prov:wasAssociatedWith ?agent ;
                          prov:used ?truck .
  
                FILTER NOT EXISTS {
                    ?truck ex:isLoadedWith ?load .
                }

                FILTER NOT EXISTS {
                    ?truck saref:hasState [
                        a s4auto:AtPickUpSpot ;
                        ] .
                }
            }
            """ ;
        ] .


